export function getMarketplaceModule(moduleId: string): MarketplaceModule | undefined {
  return MARKETPLACE_MODULE_REGISTRY.find((module) => module.id === moduleId);
}

export function getMarketplaceCapability(capabilityId: string): MarketplaceCapability | undefined {
  return MARKETPLACE_CAPABILITY_REGISTRY.find((capability) => capability.id === capabilityId);
}
